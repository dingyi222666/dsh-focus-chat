{
  "compilerOptions": {
    // The dsh base line's target: ES2024's default full lib carries
    // Disposable/Symbol.dispose, which the host half's observation leases
    // and the dsh session types reference.
    "target": "ES2024",
    "lib": [
      "ES2024",
      "ESNext.Disposable",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "tests"
  ]
}
